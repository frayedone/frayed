            border-width: 1px;
            border-color: Tokens.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);
            drop-shadow-offset-y: 6px;

            Rectangle {
                x: 12px;
                y: 20px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
