                Text {
                    width: 100%;
                    height: 100%;
                    text: "Free time";
                    font-size: 11px;
                    color: Tokens.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // edit
        if (root.screen == "edit"): Rectangle {
            x: 0;
            y: 84px;
            width: 430px;
            height: 660px;

            Text {
                x: 24px;
                y: 0;
                text: "Предмет";
                font-size: 11px;
                color: Tokens.secondary;
            }
            Rectangle {
                x: 20px;
                y: 18px;
                width: 390px;
                height: 46px;
                border-radius: 11px;
                background: Tokens.elevated;
                border-width: 1px;
                border-color: Tokens.border;
            }
            title-input := TextInput {
                x: 36px;
                y: 18px;
                width: 358px;
                height: 46px;
                text <=> root.form-title;
                font-size: 14px;
                color: Tokens.text;
                selection-background-color: Tokens.accent;
                selection-foreground-color: Tokens.bg;
                vertical-alignment: center;
            }

            Text {
                x: 24px;
                y: 82px;
                text: "Аудитория";
                font-size: 11px;
                color: Tokens.secondary;
            }
            Rectangle {
                x: 20px;
                y: 100px;
                width: 390px;
                height: 46px;
                border-radius: 11px;
                background: Tokens.elevated;
                border-width: 1px;
                border-color: Tokens.border;
            }
            room-input := TextInput {
                x: 36px;
                y: 100px;
                width: 358px;
                height: 46px;
                text <=> root.form-room;
                font-size: 14px;
                color: Tokens.text;
                selection-background-color: Tokens.accent;
                selection-foreground-color: Tokens.bg;
                vertical-alignment: center;
            }

            Text {
                x: 24px;
                y: 164px;
                text: "Начало";
                font-size: 11px;
                color: Tokens.secondary;
            }
            Rectangle {
                x: 20px;
                y: 182px;
                width: 390px;
                height: 46px;
                border-radius: 11px;
                background: Tokens.elevated;
                border-width: 1px;
                border-color: Tokens.border;
            }
            start-input := TextInput {
                x: 36px;
                y: 182px;
                width: 358px;
                height: 46px;
                text <=> root.form-start;
                input-type: InputType.text;
                font-size: 14px;
                color: Tokens.text;
                selection-background-color: Tokens.accent;
                selection-foreground-color: Tokens.bg;
                vertical-alignment: center;
            }

            Text {
                x: 24px;
                y: 246px;
                text: "Конец";
                font-size: 11px;
                color: Tokens.secondary;
            }
            Rectangle {
                x: 20px;
                y: 264px;
                width: 390px;
                height: 46px;
                border-radius: 11px;
                background: Tokens.elevated;
                border-width: 1px;
                border-color: Tokens.border;
            }
            end-input := TextInput {
                x: 36px;
                y: 264px;
                width: 358px;
                height: 46px;
                text <=> root.form-end;
                input-type: InputType.text;
                font-size: 14px;
                color: Tokens.text;
                selection-background-color: Tokens.accent;
                selection-foreground-color: Tokens.bg;
                vertical-alignment: center;
            }

            Text {
                x: 24px;
                y: 322px;
                text: "Формат HH:MM";
                font-size: 11px;
                color: Tokens.accent-2;
            }

            Text {
                x: 24px;
                y: 356px;
                text: "Тип занятия";
                font-size: 11px;
                color: Tokens.secondary;
            }

            PillButton {
                x: 20px; y: 382px; width: 60px; height: 38px;
                label: "Лекция"; active: root.form-kind == 0;
                pressed => { root.form-kind = 0; }
            }
            PillButton {
                x: 86px; y: 382px; width: 60px; height: 38px;
                label: "Лаба"; active: root.form-kind == 1;
                pressed => { root.form-kind = 1; }
            }
            PillButton {
                x: 152px; y: 382px; width: 60px; height: 38px;
                label: "Тест"; active: root.form-kind == 2;
                pressed => { root.form-kind = 2; }
            }
            PillButton {
                x: 218px; y: 382px; width: 60px; height: 38px;
                label: "Практика"; active: root.form-kind == 3;
                pressed => { root.form-kind = 3; }
            }
            PillButton {
                x: 284px; y: 382px; width: 60px; height: 38px;
                label: "Перерыв"; active: root.form-kind == 4;
                pressed => { root.form-kind = 4; }
            }
            PillButton {
                x: 350px; y: 382px; width: 60px; height: 38px;
                label: "Другое"; active: root.form-kind == 5;
                pressed => { root.form-kind = 5; }
            }

            PillButton {
                x: 20px;
                y: 500px;
                width: 240px;
                height: 48px;
                label: "Сохранить";
                active: true;
                pressed => {
                    root.edit-save(root.form-title, root.form-room, root.form-start, root.form-end, root.form-kind);
                }
            }
            PillButton {
                x: 272px;
                y: 500px;
                width: 138px;
                height: 48px;
                label: "Отмена";
                pressed => { root.edit-close(); }
            }
        }
    }

    // ------------------------------------------------------------ bottom nav
    Rectangle {
        x: 0;
        y: 792px;
        width: 430px;
        height: 68px;
        background: Tokens.bg;

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: Tokens.border;
        }

        TouchArea {
            x: 0;
            y: 1px;
            width: 86px;
            height: 67px;
            clicked => { root.nav-pressed("home"); }

            if (root.screen == "home"): Rectangle {
                x: 33px;
                y: 12px;
                width: 20px;
                height: 3px;
                border-radius: 2px;
                background: Tokens.accent;
            }

            Text {
                x: 0;
                y: 36px;
                width: 100%;
                text: "Home";
                font-size: 11px;
                color: root.screen == "home" ? Tokens.accent : Tokens.secondary;
                horizontal-alignment: center;
            }
        }

        TouchArea {
            x: 86px;
            y: 1px;
            width: 86px;
            height: 67px;
            clicked => { root.nav-pressed("schedule"); }

            if (root.screen == "schedule" || root.screen == "edit"): Rectangle {
                x: 33px;
                y: 12px;
                width: 20px;
                height: 3px;
                border-radius: 2px;
                background: Tokens.accent;
            }

            Text {
                x: 0;
                y: 36px;
                width: 100%;
                text: "Schedule";
                font-size: 11px;
                color: root.screen == "schedule" || root.screen == "edit" ? Tokens.accent : Tokens.secondary;
                horizontal-alignment: center;
            }
        }

        TouchArea {
            x: 181px;
            y: 8px;
            width: 52px;
            height: 52px;
            clicked => { root.nav-pressed("add"); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 26px;
                background: Tokens.accent;
                drop-shadow-blur: 12px;
                drop-shadow-color: rgba(34, 197, 94, 0.3);
                drop-shadow-offset-y: 3px;
            }

            Text {
                width: 100%;
                height: 100%;
                text: "+";
                font-size: 30px;
                color: Tokens.bg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        TouchArea {
            x: 258px;
            y: 1px;
            width: 86px;
            height: 67px;
            clicked => { root.nav-pressed("menu"); }

            if (root.screen == "menu"): Rectangle {
                x: 33px;
                y: 12px;
                width: 20px;
                height: 3px;
                border-radius: 2px;
                background: Tokens.accent;
            }

            Text {
                x: 0;
                y: 36px;
                width: 100%;
                text: "Menu";
                font-size: 11px;
                color: root.screen == "menu" ? Tokens.accent : Tokens.secondary;
                horizontal-alignment: center;
            }
        }

        TouchArea {
            x: 344px;
            y: 1px;
            width: 86px;
            height: 67px;
            clicked => { root.nav-pressed("ai"); }

            if (root.screen == "ai"): Rectangle {
                x: 33px;
                y: 12px;
                width: 20px;
                height: 3px;
                border-radius: 2px;
                background: Tokens.accent;
            }

            Text {
                x: 0;
                y: 36px;
                width: 100%;
                text: "AI";
                font-size: 11px;
                color: root.screen == "ai" ? Tokens.accent : Tokens.secondary;
                horizontal-alignment: center;
            }
        }
    }
}
