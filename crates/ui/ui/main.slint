// Frayed UI — dark schedule shell with Base 02 display type.
global Tokens {
    out property <color> bg: #0B0F14;
    out property <color> card: #181E29;
    out property <color> elevated: #1E2532;
    out property <color> text: #F8FAFC;
    out property <color> secondary: #8B929C;
    out property <color> accent: #22C55E;
    out property <color> accent-2: #38BDF8;
    out property <color> border: #283040;
    out property <color> warm: #FBBF24;
}

export struct BlockView {
    time: string,
    title: string,
    subtitle: string,
    accent: color,
    tint: color,
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback pressed();

    background: root.active ? Tokens.accent : Tokens.elevated;
    border-width: 1px;
    border-color: root.active ? Tokens.accent : Tokens.border;
    border-radius: 10px;
    opacity: root.enabled ? 1 : 0.55;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 12px;
        color: root.active ? Tokens.bg : Tokens.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
}

export component MainWindow inherits Window {
    preferred-width: 430px;
    preferred-height: 860px;
    width: 430px;
    height: 860px;
    background: Tokens.bg;

    in property <string> status-time: "9:41";
    in property <string> month-title: "April 2026";
    in property <[string]> weekday-letters;
    in property <[string]> weekday-numbers;
    in property <int> selected-day: 0;
    in property <[BlockView]> blocks;
    in property <string> alert-title;
    in property <string> alert-subtitle;
    in property <string> streak-title;
    in property <string> streak-subtitle;
    in property <string> weather-text;
    in property <string> transit-text;
    in property <string> update-text;
    in property <string> screen: "schedule";
    in property <bool> busy: false;
    in property <string> edit-title;
    in property <string> edit-room;
    in property <string> edit-start;
    in property <string> edit-end;
    in property <int> edit-kind;

    callback day-selected(int);
    callback nav-pressed(string);
    callback today-pressed();
    callback block-selected(int);
    callback refresh-pressed();
    callback cancel-day-pressed();
    callback preset-pressed(int);
    callback update-pressed();
    callback edit-save(string, string, string, string, int);
    callback edit-close();

    // ponytail: edit-* are in properties, so the editable copies live here and are re-seeded on entry.
    property <string> form-title: root.edit-title;
    property <string> form-room: root.edit-room;
    property <string> form-start: root.edit-start;
    property <string> form-end: root.edit-end;
    property <int> form-kind: root.edit-kind;

    changed screen => {
        if (root.screen == "edit") {
            root.form-title = root.edit-title;
            root.form-room = root.edit-room;
            root.form-start = root.edit-start;
            root.form-end = root.edit-end;
            root.form-kind = root.edit-kind;
        }
    }
    changed edit-title => { root.form-title = root.edit-title; }
    changed edit-room => { root.form-room = root.edit-room; }
    changed edit-start => { root.form-start = root.edit-start; }
    changed edit-end => { root.form-end = root.edit-end; }
    changed edit-kind => { root.form-kind = root.edit-kind; }

    // status bar
    Rectangle {
        x: 0;
        y: 0;
        width: 430px;
        height: 36px;

        Text {
            x: 24px;
            y: 9px;
            text: root.status-time;
            font-size: 13px;
            font-weight: 600;
            color: Tokens.text;
        }

        Text {
            x: 292px;
            y: 9px;
            text: "▮▮▮ ⌁ ▰";
            font-size: 12px;
            color: Tokens.secondary;
        }

        if (root.busy): Text {
            x: 232px;
            y: 10px;
            text: "working…";
            font-size: 11px;
            color: Tokens.accent;
        }
    }

    // ---------------------------------------------------------------- schedule
    if (root.screen == "schedule"): Rectangle {
        x: 0;
        y: 36px;
        width: 430px;
        height: 756px;

        Text {
            x: 24px;
            y: 14px;
            text: root.month-title;
            font-size: 23px;
            font-weight: 700;
            color: Tokens.text;
            font-family: "Base 02"; // ponytail: Slint 1.19 takes one family; Latn/Cyrl fallbacks registered in lib.rs
        }

        TouchArea {
            x: 338px;
            y: 12px;
            width: 68px;
            height: 34px;
            clicked => { root.today-pressed(); }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 17px;
                border-width: 1px;
                border-color: Tokens.accent;
                background: rgba(34, 197, 94, 0.08);
            }

            Text {
                width: 100%;
                height: 100%;
                text: "Today";
                font-size: 12px;
                color: Tokens.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // week strip — driven entirely by the model arrays
        for day[i] in root.weekday-letters: TouchArea {
            x: 24px + i * 56px;
            y: 62px;
            width: 46px;
            height: 88px;
            clicked => { root.day-selected(i); }

            Rectangle {
                x: 1px;
                y: 8px;
                width: 44px;
                height: 54px;
                border-radius: 14px;
                background: i == root.selected-day ? Tokens.accent : rgba(34, 197, 94, 0);
            }

            Text {
                x: 0;
                y: 15px;
                width: 100%;
                text: day;
                font-size: 11px;
                font-weight: 700;
                color: i == root.selected-day ? Tokens.bg : Tokens.secondary;
                horizontal-alignment: center;
            }

            Text {
                x: 0;
                y: 35px;
                width: 100%;
                text: root.weekday-numbers[i];
                font-size: 18px;
                font-weight: 600;
                color: i == root.selected-day ? Tokens.bg : Tokens.text;
                horizontal-alignment: center;
            }
        }

        Flickable {
            x: 0;
            y: 158px;
            width: 430px;
            height: 634px;
            content-width: 430px;
            content-height: root.blocks.length * 76px + 40px;

            if (root.blocks.length == 0): Text {
                x: 24px;
                y: 60px;
                width: 382px;
                text: "No classes planned for this day.";
                font-size: 13px;
                color: Tokens.secondary;
            }

            for block[i] in root.blocks: Rectangle {
                x: 0;
                y: i * 76px;
                width: 430px;
                height: 76px;

                Text {
                    x: 24px;
                    y: 26px;
                    width: 54px;
                    text: block.time;
                    font-size: 12px;
                    color: Tokens.secondary;
                }

                Rectangle {
                    x: 86px;
                    y: 8px;
                    width: 320px;
                    height: 60px;
                    border-radius: 12px;
                    background: Tokens.card;
                    border-width: 1px;
                    border-color: Tokens.border;
                }

                Rectangle {
                    x: 86px;
                    y: 8px;
                    width: 320px;
                    height: 60px;
                    border-radius: 12px;
                    background: block.tint;
                }

                Rectangle {
                    x: 92px;
                    y: 20px;
                    width: 4px;
                    height: 36px;
                    border-radius: 2px;
