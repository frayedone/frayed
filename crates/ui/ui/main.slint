// Frayed UI — faithful port of the Freya dark theme to Slint.
// Base 02 is a DISPLAY face (caps + wide tracking, pre-spaced by Rust); body is default sans.

global Tokens {
    out property <color> bg: #050607;
    out property <color> card: #101316;
    out property <color> card-raised: #171B20;
    out property <color> border: #23282F;
    out property <color> text: #F2F3F5;
    out property <color> muted: #8A939E;
    out property <color> accent: #E2A23B;
    out property <color> accent-soft: rgba(226, 162, 59, 0.14);
    out property <color> danger: #FF5C4D;
    out property <color> danger-soft: #3A1714;
    out property <color> glow: rgba(226, 162, 59, 0.22);
    out property <color> on-accent: #08090B;
}

export struct BlockView {
    time: string,
    end-time: string,
    title: string,
    meta: string,
    state: int,
    progress: float,
    reminded: bool,
}

// --- small shared primitives ------------------------------------------------

component Icon inherits Text {
    in property <string> glyph;
    in property <length> icon-size: 20px;
    in property <color> tint: Tokens.muted;

    text: root.glyph;
    font-family: "Material Icons";
    font-size: root.icon-size;
    color: root.tint;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Tokens.muted;
    in property <length> size: 20px;
    callback pressed();

    width: 34px;
    height: 34px;
    border-radius: 10px;

    Icon {
        width: parent.width; height: parent.height;
        glyph: root.glyph;
        icon-size: root.size;
        tint: root.tint;
    }
    TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.pressed(); }
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> filled: false;
    in property <bool> enabled: true;
    in property <length> radius: 14px;
    callback pressed();

    background: root.filled ? Tokens.accent : (root.active ? Tokens.accent-soft : Tokens.card-raised);
    border-width: 1px;
    border-color: root.filled ? Tokens.accent : (root.active ? Tokens.accent : Tokens.border);
    border-radius: root.radius;
    opacity: root.enabled ? 1 : 0.5;

    Text {
        width: parent.width; height: parent.height;
        text: root.label;
        font-size: 12.5px;
        font-weight: 700;
        color: root.filled ? Tokens.on-accent : (root.active ? Tokens.accent : Tokens.text);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
}

component SectionLabel inherits Rectangle {
    in property <string> label;
    height: 34px;
    Rectangle { x: 20px; y: 9px; width: 3px; height: 16px; border-radius: 2px; background: Tokens.accent; }
    Text {
        x: 33px; y: 0; width: parent.width - 48px; height: parent.height;
        text: root.label;
        font-family: "Base 02";
        font-size: 14px;
        color: Tokens.text;
        vertical-alignment: center;
        overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
    }
}

component FormField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    height: 44px;
    background: Tokens.card-raised;
    border-width: 1px;
    border-color: Tokens.border;
    border-radius: 12px;

    Text {
        x: 12px; y: 0; width: 92px; height: parent.height;
        text: root.label;
        font-size: 11.5px;
        color: Tokens.muted;
        vertical-alignment: center;
        overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
    }
    TextInput {
        x: 104px; y: 0; width: parent.width - 116px; height: parent.height;
        text <=> root.text;
        font-size: 14px;
        color: Tokens.text;
        vertical-alignment: center;
        selection-background-color: Tokens.accent;
        selection-foreground-color: Tokens.on-accent;
    }
}

// --- one reusable lesson card + rail ---------------------------------------

component LessonRow inherits Rectangle {
    in property <BlockView> block;
    in property <bool> first;
    in property <bool> last;
    callback selected();
    callback remind();

    property <bool> live: root.block.state == 1 || root.block.state == 2;
    property <bool> dimmed: root.block.state == 0 || root.block.state == 4;
    property <bool> cancelled: root.block.state == 4;
    property <length> dot-size: root.block.state == 1 ? 9px : 7px;
    property <color> dot-color: root.cancelled ? Tokens.danger : (root.block.state == 3 ? Tokens.muted : Tokens.accent);

    // time column
    Text {
        x: 0; y: 11px; width: 46px;
        text: root.block.time;
        font-size: 14.5px; font-weight: 800; color: Tokens.text;
    }
    Text {
        x: 0; y: 31px; width: 46px;
        text: root.block.end-time;
        font-size: 11px; font-weight: 600; color: Tokens.muted;
    }

    // rail: border line, live/past fill, dot
    Rectangle {
        x: 58px; y: 0; width: 9px; height: parent.height;
        Rectangle {
            x: 3.625px; y: 0; width: 1.75px; height: parent.height;
            background: Tokens.border;
        }
        Rectangle {
            x: 3.625px; y: 0; width: 1.75px;
            height: root.block.state == 0 ? root.height : (root.block.state == 1 ? 19px + (root.height - 19px) * root.block.progress : 0px);
            background: Tokens.accent;
        }
        Rectangle {
            x: (9px - root.dot-size) / 2;
            y: 15px - root.dot-size / 2;
            width: root.dot-size; height: root.dot-size;
            border-radius: root.dot-size / 2;
            background: root.dot-color;
        }
    }

    // lesson card
    Rectangle {
        x: 79px; y: 0; width: parent.width - 79px; height: parent.height - 6px;
        background: root.live ? Tokens.card-raised : Tokens.card;
        border-width: 1px;
        border-color: root.live ? rgba(226, 162, 59, 0.85) : Tokens.border;
        border-radius: 16px;
        opacity: root.dimmed ? 0.4 : 1;
        drop-shadow-blur: root.live ? 18px : 0px;
        drop-shadow-color: Tokens.glow;
        drop-shadow-offset-y: root.live ? 6px : 0px;

        if (root.cancelled): Rectangle {
            x: 14px; y: 10px; width: 96px; height: 21px;
            border-radius: 6px;
            background: Tokens.danger-soft;
            Text {
                width: parent.width; height: parent.height;
                text: "Отменено";
                font-size: 11px; font-weight: 800; color: Tokens.danger;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        Text {
            x: 14px;
            y: root.cancelled ? 38px : 12px;
            width: parent.width - 58px; height: 38px;
            text: root.block.title;
            font-size: 15.5px; font-weight: 700; color: Tokens.text;
            wrap: TextWrap.word-wrap;
            overflow: TextOverflow.elide;
        }
        Text {
            x: 14px;
            y: root.cancelled ? 78px : 52px;
            width: parent.width - 58px; height: 16px;
            text: root.block.meta;
            font-size: 12px; color: Tokens.muted;
            overflow: TextOverflow.elide;
            wrap: TextWrap.no-wrap;
        }
        if (root.live): Text {
            x: 14px;
            y: root.cancelled ? 98px : 72px;
            width: parent.width - 58px; height: 16px;
            text: root.block.state == 1 ? "Идёт сейчас" : "Скоро";
            font-size: 11px; font-weight: 800; color: Tokens.accent;
        }

        TouchArea {
            x: 0; y: 0; width: parent.width; height: parent.height;
            clicked => { root.selected(); }
        }

        if (!root.cancelled): IconButton {
            x: parent.width - 44px; y: 11px;
            glyph: root.block.reminded ? "\u{e7f7}" : "\u{e7f5}";
            tint: root.block.reminded ? Tokens.accent : Tokens.muted;
            size: 19px;
            pressed => { root.remind(); }
        }
    }
}

// --- main window ------------------------------------------------------------

export component MainWindow inherits Window {
    in property <string> screen;
    in property <bool> busy;
    in property <string> toast;
    in property <string> update-version;

    in property <string> date-label;
    in property <string> weekday-name;
    in property <bool> is-today;
    in property <string> group-name;

    in property <[string]> day-labels;
    in property <[string]> day-numbers;
    in property <[int]> day-states;
    in property <int> selected-day;

    in property <string> context-line;
    in property <bool> day-cancelled;
    in property <string> weather-hint;
    in property <bool> weather-rainy;
    in property <bool> empty-day;
    in property <[BlockView]> blocks;

    in property <color> hero-top;
    in property <color> hero-mid;
    in property <color> hero-bottom;
    in property <string> weather-temp;
    in property <string> weather-condition;
    in property <string> weather-stats;
    in property <[string]> forecast;

    in property <int> transport-mode;
    in property <[string]> stop-names;
    in property <int> selected-stop;
    in property <[string]> arrivals;
    in property <[string]> itinerary;
    in property <string> route-from;
    in property <string> route-to;

    in property <string> settings-text;

    in property <string> edit-title;
    in property <string> edit-room;
    in property <string> edit-teacher;
    in property <string> edit-start;
    in property <string> edit-end;
    in property <int> edit-kind;

    callback day-selected(int);
    callback nav-pressed(string);
    callback today-pressed();
    callback block-selected(int);
    callback remind-pressed(int);
    callback add-pressed();
    callback cancel-day-pressed();
    callback preset-pressed(int);
    callback update-pressed();
    callback refresh-pressed();
    callback transport-mode-changed(int);
    callback stop-selected(int);
    callback route-built(string, string);
    callback edit-save(string, string, string, string, string, int);
    callback edit-close();
    callback toast-dismissed();
    callback data-reloaded();

    preferred-width: 430px;
    preferred-height: 860px;
    width: 430px;
    height: 860px;
    background: Tokens.bg;

    // shell metrics
    property <length> banner-h: root.update-version != "" ? 46px : 0px;
    property <length> body-y: root.banner-h;
    property <length> body-h: 860px - 68px - root.banner-h;
    property <length> timeline-y: root.day-cancelled ? 286px : (root.weather-hint != "" ? 330px : 290px);
    property <bool> sched-active: root.screen == "schedule" || root.screen == "edit" || root.screen == "presets";

    // ponytail: edit/route fields are `in`, so editable copies live here and are re-seeded on entry.
    property <string> form-title: root.edit-title;
    property <string> form-room: root.edit-room;
    property <string> form-teacher: root.edit-teacher;
    property <string> form-start: root.edit-start;
    property <string> form-end: root.edit-end;
    property <int> form-kind: root.edit-kind;
    property <string> form-from: root.route-from;
    property <string> form-to: root.route-to;
    property <string> swap-tmp;

    changed screen => {
        if (root.screen == "edit") {
            root.form-title = root.edit-title;
            root.form-room = root.edit-room;
            root.form-teacher = root.edit-teacher;
            root.form-start = root.edit-start;
            root.form-end = root.edit-end;
            root.form-kind = root.edit-kind;
        }
        if (root.screen == "transport") {
            root.form-from = root.route-from;
            root.form-to = root.route-to;
        }
    }
    changed edit-title => { root.form-title = root.edit-title; }
    changed edit-room => { root.form-room = root.edit-room; }
    changed edit-teacher => { root.form-teacher = root.edit-teacher; }
    changed edit-start => { root.form-start = root.edit-start; }
    changed edit-end => { root.form-end = root.edit-end; }
    changed edit-kind => { root.form-kind = root.edit-kind; }
    changed route-from => { root.form-from = root.route-from; }
    changed route-to => { root.form-to = root.route-to; }

    // base background
    Rectangle { width: parent.width; height: parent.height; background: Tokens.bg; }

    // persistent update banner
    if (root.update-version != ""): Rectangle {
        x: 0; y: 0; width: parent.width; height: root.banner-h;
        background: Tokens.accent-soft;

        Icon {
            x: 18px; y: 0; width: 24px; height: parent.height;
            glyph: "\u{e5d8}"; icon-size: 19px; tint: Tokens.accent;
        }
        Text {
            x: 46px; y: 0; width: parent.width - 190px; height: parent.height;
            text: "Обновление " + root.update-version;
            font-size: 12.5px; font-weight: 700; color: Tokens.text;
            vertical-alignment: center;
            overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
        }
        TouchArea {
            x: parent.width - 108px; y: 0; width: 96px; height: parent.height;
            clicked => { root.update-pressed(); }
            Text {
                width: parent.width; height: parent.height;
                text: "Обновить"; font-size: 12px; font-weight: 800; color: Tokens.accent;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }
        Rectangle {
            x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
            background: rgba(226, 162, 59, 0.35);
        }
    }

    if (root.busy): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: 2px;
        background: Tokens.accent;
    }

    // ============================================================ SCHEDULE
    if (root.screen == "schedule"): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: root.body-h;

        // app bar
        HorizontalLayout {
            x: 0; y: 6px; width: parent.width; height: 40px;
            padding-left: 18px; padding-right: 10px; spacing: 4px;

            Text {
                horizontal-stretch: 1;
                text: "Расписание";
                font-family: "Base 02"; font-size: 22px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
            IconButton {
                horizontal-stretch: 0;
                glyph: "\u{e8b8}"; size: 20px;
                pressed => { root.nav-pressed("settings"); }
            }
            IconButton {
                horizontal-stretch: 0;
                glyph: "\u{e145}"; size: 22px;
                pressed => { root.add-pressed(); }
            }
        }

        // header (date / weekday / group)
        TouchArea {
            x: 0; y: 54px; width: parent.width; height: 114px;
            clicked => { root.today-pressed(); }

            HorizontalLayout {
                x: 18px; y: 4px; width: parent.width - 36px; height: 24px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.date-label;
                    font-size: 12px; font-weight: 700; color: Tokens.muted;
                    vertical-alignment: center;
                    overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
                }
                if (root.is-today): Rectangle {
                    horizontal-stretch: 0;
                    width: 84px; height: 22px;
                    border-radius: 999px;
                    background: Tokens.accent-soft;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "Сегодня"; font-size: 11.5px; font-weight: 800; color: Tokens.accent;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
            Text {
                x: 16px; y: 30px; width: parent.width - 32px; height: 44px;
                text: root.weekday-name;
                font-family: "Base 02"; font-size: 34px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
            Rectangle {
                x: 18px; y: 80px; width: 180px; height: 28px;
                border-radius: 999px;
                background: Tokens.card;
                border-width: 1px; border-color: Tokens.border;
                Text {
                    x: 10px; width: parent.width - 20px; height: parent.height;
                    text: "Группа " + root.group-name;
                    font-size: 12px; font-weight: 700; color: Tokens.text;
                    vertical-alignment: center;
                    overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
                }
            }
        }

        // day strip
        Rectangle {
            x: 0; y: 168px; width: parent.width; height: 56px;

            HorizontalLayout {
                x: 0; y: 0; width: parent.width; height: parent.height;

                for day[i] in root.day-labels: day-cell := TouchArea {
                    horizontal-stretch: 1;
                    property <int> st: i < root.day-states.length ? root.day-states[i] : 0;
                    property <bool> sel: st == 1 || st == 3 || st == 5 || st == 7;
                    property <bool> has: st == 2 || st == 3 || st == 6 || st == 7;
                    property <bool> can: st == 4 || st == 5 || st == 6 || st == 7;
                    property <color> day-accent: day-cell.can ? Tokens.danger : Tokens.accent;

                    clicked => { root.day-selected(i); }

                    Rectangle {
                        x: 2px; y: 6px; width: parent.width - 4px; height: parent.height - 12px;
                        border-radius: 12px;
                        background: day-cell.sel ? rgba(226, 162, 59, 0.12) : transparent;
                    }
                    Text {
                        x: 0; y: 8px; width: parent.width; height: 16px;
                        text: day;
                        font-size: 11.5px; font-weight: 700;
                        color: day-cell.sel ? day-cell.day-accent : Tokens.text;
                        horizontal-alignment: center;
                        overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
                    }
                    Text {
                        x: 0; y: 24px; width: parent.width; height: 20px;
                        text: i < root.day-numbers.length ? root.day-numbers[i] : "";
                        font-size: 16px; font-weight: 800;
                        color: day-cell.sel ? day-cell.day-accent : Tokens.text;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        x: parent.width / 2 - (day-cell.sel ? 9px : (day-cell.has ? 2px : 0px));
                        y: 46px;
                        width: day-cell.sel ? 18px : (day-cell.has ? 4px : 0px);
                        height: 4px;
                        border-radius: 999px;
                        background: day-cell.can ? Tokens.danger : (day-cell.sel ? Tokens.accent : (day-cell.has ? Tokens.border : transparent));
                    }
                    if (i < 6): Rectangle {
                        x: parent.width - 0.5px; y: 16px; width: 1px; height: 24px;
                        background: Tokens.border;
                    }
                }
            }
            Rectangle {
                x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
                background: Tokens.border;
            }
        }

        // cancelled banner
        if (root.day-cancelled): Rectangle {
            x: 18px; y: 230px; width: parent.width - 36px; height: 42px;
            border-radius: 6px;
            background: Tokens.danger-soft;
            border-width: 1px; border-color: rgba(255, 92, 77, 0.35);
            Icon {
                x: 12px; y: 0; width: 20px; height: parent.height;
                glyph: "\u{e615}"; icon-size: 17px; tint: Tokens.danger;
            }
            Text {
                x: 38px; y: 4px; width: parent.width - 140px; height: parent.height - 8px;
                text: "День отменён — пары сегодня не состоятся";
                font-size: 12.5px; font-weight: 600; color: Tokens.danger;
                vertical-alignment: center;
                wrap: TextWrap.word-wrap;
            }
            TouchArea {
                x: parent.width - 100px; y: 0; width: 92px; height: parent.height;
                clicked => { root.cancel-day-pressed(); }
                Text {
                    width: parent.width; height: parent.height;
                    text: "Вернуть"; font-size: 12px; font-weight: 700; color: Tokens.danger;
                    horizontal-alignment: right; vertical-alignment: center;
                }
            }
        }

        // inline context line
        if (!root.day-cancelled && root.context-line != ""): Rectangle {
            x: 18px; y: 232px; width: parent.width - 36px; height: 28px;
            Rectangle {
                x: 5px; y: 11px; width: 6px; height: 6px;
                border-radius: 3px; background: Tokens.accent;
            }
            Text {
                x: 19px; y: 0; width: parent.width - 19px; height: parent.height;
                text: root.context-line;
                font-size: 12.5px; font-weight: 600; color: Tokens.text;
                vertical-alignment: center;
                wrap: TextWrap.word-wrap;
            }
        }
        if (!root.day-cancelled): TouchArea {
            x: parent.width - 130px; y: 264px; width: 112px; height: 24px;
            clicked => { root.cancel-day-pressed(); }
            Text {
                width: parent.width; height: parent.height;
                text: "Отменить день"; font-size: 12px; color: Tokens.muted;
                horizontal-alignment: right; vertical-alignment: center;
            }
        }

        // weather hint
        if (!root.day-cancelled && root.weather-hint != ""): Rectangle {
            x: 18px; y: 282px; width: parent.width - 36px; height: 38px;
            border-radius: 12px;
            background: Tokens.card;
            border-width: 1px;
            border-color: root.weather-rainy ? rgba(226, 162, 59, 0.55) : Tokens.border;
            Icon {
                x: 10px; y: 0; width: 18px; height: parent.height;
                glyph: root.weather-rainy ? "\u{e2bd}" : "\u{e1ff}";
                icon-size: 17px;
                tint: root.weather-rainy ? Tokens.accent : Tokens.muted;
            }
            Text {
                x: 34px; y: 4px; width: parent.width - 46px; height: parent.height - 8px;
                text: root.weather-hint;
                font-size: 12px; font-weight: 600;
                color: root.weather-rainy ? Tokens.accent : Tokens.text;
                vertical-alignment: center;
                wrap: TextWrap.word-wrap;
            }
        }

        // timeline / empty day
        if (root.empty-day): Rectangle {
            x: 0; y: root.timeline-y; width: parent.width; height: root.body-h - root.timeline-y;
            Rectangle {
                x: parent.width / 2 - 36px; y: 40px; width: 72px; height: 72px;
                border-radius: 36px;
                background: Tokens.card;
                border-width: 1px; border-color: Tokens.border;
                Icon {
                    width: parent.width; height: parent.height;
                    glyph: "\u{ef5e}"; icon-size: 30px; tint: Tokens.accent;
                }
            }
            Text {
                x: 0; y: 128px; width: parent.width; height: 32px;
                text: "Т И Ш И Н А";
                font-family: "Base 02"; font-size: 22px; color: Tokens.text;
                horizontal-alignment: center;
            }
            Text {
                x: 0; y: 166px; width: parent.width; height: 20px;
                text: "В этот день пар нет";
                font-size: 13px; font-weight: 600; color: Tokens.muted;
                horizontal-alignment: center;
            }
        }
        if (!root.empty-day): Flickable {
            x: 18px; y: root.timeline-y;
            width: parent.width - 36px;
            height: root.body-h - root.timeline-y - 8px;
            content-height: root.blocks.length * 100px + 16px;

            for block[i] in root.blocks: LessonRow {
                x: 0; y: i * 100px; width: parent.width; height: 100px;
                block: block;
                first: i == 0;
                last: i == root.blocks.length - 1;
                selected => { root.block-selected(i); }
                remind => { root.remind-pressed(i); }
            }
        }
    }

    // ============================================================== WEATHER
    if (root.screen == "weather"): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: root.body-h;

        HorizontalLayout {
            x: 0; y: 6px; width: parent.width; height: 40px;
            padding-left: 18px; padding-right: 10px; spacing: 4px;

            Text {
                horizontal-stretch: 1;
                text: "Погода";
                font-family: "Base 02"; font-size: 22px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
            IconButton {
                horizontal-stretch: 0;
                glyph: "\u{e5d5}"; size: 24px;
                pressed => { root.refresh-pressed(); }
            }
        }

        Flickable {
            x: 0; y: 56px; width: parent.width; height: root.body-h - 56px;
            content-height: 232px + 20px + 30px + 4px + root.forecast.length * 62px + 24px;

            // hero
            Rectangle {
                x: 16px; y: 0; width: parent.width - 32px; height: 232px;
                border-radius: 28px;
                background: @linear-gradient(135deg, root.hero-top 0%, root.hero-mid 50%, root.hero-bottom 100%);

                Icon {
                    x: 0; y: 26px; width: parent.width; height: 76px;
                    glyph: "\u{e1ff}"; icon-size: 64px; tint: #FFFFFFFF;
                }
                Text {
                    x: 0; y: 106px; width: parent.width; height: 80px;
                    text: root.weather-temp;
                    font-family: "Base 02"; font-size: 72px; color: white;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: TextWrap.no-wrap;
                }
                Text {
                    x: 0; y: 174px; width: parent.width; height: 24px;
                    text: root.weather-condition;
                    font-size: 16px; color: #B3FFFFFF;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                Rectangle {
                    x: parent.width / 2 - 120px; y: 200px; width: 240px; height: 30px;
                    border-radius: 999px;
                    background: rgba(255, 255, 255, 0.15);
                    Text {
                        width: parent.width; height: parent.height;
                        text: root.weather-stats;
                        font-size: 12px; font-weight: 600; color: white;
                        horizontal-alignment: center; vertical-alignment: center;
                        overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
                    }
                }
            }

            HorizontalLayout {
                x: 20px; y: 252px; width: parent.width - 40px; height: 26px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: "На неделю";
                    font-size: 16px; font-weight: 700; color: Tokens.text;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 0;
                    text: "Алматы";
                    font-size: 12px; color: Tokens.muted;
                    horizontal-alignment: right; vertical-alignment: center;
                }
            }

            for f[i] in root.forecast: Rectangle {
                x: 16px; y: 286px + i * 62px; width: parent.width - 32px; height: 62px;
                Text {
                    x: 8px; y: 0; width: parent.width - 16px; height: parent.height;
                    text: f;
                    font-size: 13px; color: Tokens.text;
                    vertical-alignment: center;
                    overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
                }
                Rectangle {
                    x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
                    background: Tokens.border;
                }
            }
        }
    }

    // ============================================================ TRANSPORT
    if (root.screen == "transport"): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: root.body-h;

        HorizontalLayout {
            x: 0; y: 6px; width: parent.width; height: 40px;
            padding-left: 18px; padding-right: 10px;

            Text {
                horizontal-stretch: 1;
                text: "Транспорт";
                font-family: "Base 02"; font-size: 22px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
        }

        // segmented control
        Rectangle {
            x: 16px; y: 60px; width: parent.width - 32px; height: 44px;
            border-radius: 14px;
            background: Tokens.card;
            border-width: 1px; border-color: Tokens.border;

            HorizontalLayout {
                x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px;
                spacing: 0px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 11px;
                    background: root.transport-mode == 0 ? Tokens.accent-soft : transparent;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "Остановка"; font-size: 13px; font-weight: 700;
                        color: root.transport-mode == 0 ? Tokens.accent : Tokens.text;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => { root.transport-mode-changed(0); }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 11px;
                    background: root.transport-mode == 1 ? Tokens.accent-soft : transparent;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "Маршрут"; font-size: 13px; font-weight: 700;
                        color: root.transport-mode == 1 ? Tokens.accent : Tokens.text;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => { root.transport-mode-changed(1); }
                    }
                }
            }
        }

        // ---- stop mode
        if (root.transport-mode == 0): Rectangle {
            x: 0; y: 116px; width: parent.width; height: root.body-h - 116px;

            Flickable {
                x: 16px; y: 0; width: parent.width - 32px; height: 42px;
                content-width: root.stop-names.length * 168px;
                    for stop[i] in root.stop-names: Rectangle {
                    x: i * 168px; y: 0; width: 160px; height: 38px;
                    border-radius: 20px;
                    background: i == root.selected-stop ? Tokens.accent-soft : Tokens.card;
                    border-width: 1px;
                    border-color: i == root.selected-stop ? Tokens.accent : Tokens.border;
                    Text {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        text: stop;
                        font-size: 12px; font-weight: 700;
                        color: i == root.selected-stop ? Tokens.accent : Tokens.muted;
                        vertical-alignment: center;
                        overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
                    }
                    TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => { root.stop-selected(i); }
                    }
                }
            }

            Flickable {
                x: 0; y: 54px; width: parent.width; height: parent.height - 54px;
                content-height: root.arrivals.length * 70px + 24px;
                    for a[i] in root.arrivals: Rectangle {
                    x: 16px; y: i * 70px; width: parent.width - 32px; height: 62px;
                    border-radius: 14px;
                    background: Tokens.card;
                    border-width: 1px; border-color: Tokens.border;
                    Rectangle {
                        x: 10px; y: 11px; width: 44px; height: 40px;
                        border-radius: 10px;
                        background: Tokens.card-raised;
                        Icon {
                            width: parent.width; height: parent.height;
                            glyph: "\u{e530}"; icon-size: 20px; tint: Tokens.accent;
                        }
                    }
                    Text {
                        x: 66px; y: 8px; width: parent.width - 80px; height: parent.height - 16px;
                        text: a;
                        font-size: 13.5px; font-weight: 800; color: Tokens.text;
                        vertical-alignment: center;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }
        }

        // ---- route mode
        if (root.transport-mode == 1): Rectangle {
            x: 0; y: 116px; width: parent.width; height: root.body-h - 116px;

            Rectangle {
                x: 16px; y: 0; width: parent.width - 32px; height: 156px;
                border-radius: 16px;
                background: Tokens.card;
                border-width: 1px; border-color: Tokens.border;

                Text { x: 18px; y: 8px; width: parent.width - 36px; height: 20px; text: "Откуда"; font-size: 11px; color: Tokens.muted; }
                FormField {
                    x: 44px; y: 28px; width: parent.width - 60px; height: 40px;
                    label: "Начальная";
                    text <=> root.form-from;
                }
                Rectangle {
                    x: 54px; y: 70px; width: 2px; height: 16px;
                    background: Tokens.border;
                }
                Icon {
                    x: parent.width - 62px; y: 70px; width: 32px; height: 24px;
                    glyph: "\u{e8d5}"; icon-size: 21px; tint: Tokens.muted;
                }
                TouchArea {
                    x: parent.width - 66px; y: 68px; width: 42px; height: 28px;
                    clicked => {
                        root.swap-tmp = root.form-from;
                        root.form-from = root.form-to;
                        root.form-to = root.swap-tmp;
                    }
                }
                Text { x: 18px; y: 90px; width: parent.width - 110px; height: 20px; text: "Куда"; font-size: 11px; color: Tokens.muted; }
                FormField {
                    x: 44px; y: 108px; width: parent.width - 60px; height: 40px;
                    label: "Конечная";
                    text <=> root.form-to;
                }
            }

            PillButton {
                x: 16px; y: 166px; width: parent.width - 32px; height: 48px;
                label: "Построить маршрут";
                filled: true; radius: 14px;
                pressed => { root.route-built(root.form-from, root.form-to); }
            }

            Flickable {
                x: 0; y: 228px; width: parent.width; height: parent.height - 228px;
                content-height: root.itinerary.length * 96px + 24px;
                for leg[i] in root.itinerary: Rectangle {
                    x: 16px; y: i * 96px; width: parent.width - 32px; height: 88px;
                    border-radius: 16px;
                    background: Tokens.card;
                    border-width: 1px; border-color: Tokens.border;
                    Rectangle {
                        x: 14px; y: 14px; width: 26px; height: 26px;
                        border-radius: 8px;
                        background: Tokens.accent-soft;
                        Icon {
                            width: parent.width; height: parent.height;
                            glyph: "\u{e5cc}"; icon-size: 18px; tint: Tokens.accent;
                        }
                    }
                    Rectangle {
                        x: 26px; y: 40px; width: 1.75px; height: 32px;
                        background: Tokens.border;
                    }
                    Text {
                        x: 52px; y: 10px; width: parent.width - 66px; height: parent.height - 20px;
                        text: leg;
                        font-size: 13px; color: Tokens.text;
                        vertical-alignment: center;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }
        }
    }

    // ============================================================== SETTINGS
    if (root.screen == "settings"): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: root.body-h;

        HorizontalLayout {
            x: 0; y: 6px; width: parent.width; height: 40px;
            padding-left: 10px; padding-right: 18px; spacing: 8px;

            IconButton {
                horizontal-stretch: 0;
                glyph: "\u{e5c4}"; size: 22px;
                pressed => { root.nav-pressed("schedule"); }
            }
            Text {
                horizontal-stretch: 1;
                text: "Настройки";
                font-family: "Base 02"; font-size: 20px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
        }

        Flickable {
            x: 0; y: 58px; width: parent.width; height: root.body-h - 58px;
            content-height: 640px;

            SectionLabel { x: 0; y: 6px; width: parent.width; label: "Уведомления"; }
            Rectangle {
                x: 18px; y: 44px; width: parent.width - 36px; height: 150px;
                border-radius: 14px;
                background: Tokens.card;
                border-width: 1px; border-color: Tokens.border;
                Text {
                    x: 14px; y: 12px; width: parent.width - 28px; height: parent.height - 24px;
                    text: root.settings-text;
                    font-size: 13px; color: Tokens.muted;
                    wrap: TextWrap.word-wrap;
                    vertical-alignment: top;
                }
            }

            SectionLabel { x: 0; y: 208px; width: parent.width; label: "Оформление"; }
            Text {
                x: 20px; y: 246px; width: parent.width - 40px; height: 40px;
                text: "Тёмная тема · янтарь · Freya";
                font-size: 12.5px; color: Tokens.muted;
                wrap: TextWrap.word-wrap;
            }

            SectionLabel { x: 0; y: 292px; width: parent.width; label: "Пресеты"; }
            PillButton {
                x: 18px; y: 330px; width: parent.width - 36px; height: 46px;
                label: "Пресеты расписания";
                pressed => { root.nav-pressed("presets"); }
            }

            SectionLabel { x: 0; y: 392px; width: parent.width; label: "Приложение"; }
            PillButton {
                x: 18px; y: 430px; width: parent.width - 36px; height: 46px;
                label: "Обновить данные";
                pressed => { root.refresh-pressed(); }
            }
            PillButton {
                x: 18px; y: 484px; width: parent.width - 36px; height: 46px;
                label: "Проверить обновления";
                pressed => { root.update-pressed(); }
            }
            Text {
                x: 0; y: 546px; width: parent.width; height: 20px;
                text: "FRAYED · LOCAL FIRST";
                font-size: 11px; color: Tokens.muted;
                horizontal-alignment: center;
            }
        }
    }

    // =============================================================== PRESETS
    if (root.screen == "presets"): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: root.body-h;

        HorizontalLayout {
            x: 0; y: 6px; width: parent.width; height: 40px;
            padding-left: 10px; padding-right: 18px; spacing: 8px;

            IconButton {
                horizontal-stretch: 0;
                glyph: "\u{e5c4}"; size: 22px;
                pressed => { root.nav-pressed("settings"); }
            }
            Text {
                horizontal-stretch: 1;
                text: "Пресеты расписания";
                font-family: "Base 02"; font-size: 16px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
        }
        Text {
            x: 18px; y: 56px; width: parent.width - 36px; height: 48px;
            text: "Пресет — сохранённый набор пар. Переключайся между группами или вариантами недели одним касанием.";
            font-size: 12.5px; color: Tokens.muted;
            wrap: TextWrap.word-wrap;
        }

        for p[i] in [0, 1, 2]: Rectangle {
            x: 18px; y: 112px + i * 68px; width: parent.width - 36px; height: 58px;
            border-radius: 14px;
            background: Tokens.card;
            border-width: 1px; border-color: Tokens.border;
            Rectangle {
                x: 12px; y: 11px; width: 36px; height: 36px;
                border-radius: 10px;
                background: Tokens.card-raised;
                Icon {
                    width: parent.width; height: parent.height;
                    glyph: "\u{ebcc}"; icon-size: 19px; tint: Tokens.accent;
                }
            }
            Text {
                x: 58px; y: 0; width: parent.width - 76px; height: parent.height;
                text: "Пресет " + (i + 1);
                font-size: 14.5px; font-weight: 700; color: Tokens.text;
                vertical-alignment: center;
            }
            TouchArea {
                width: parent.width; height: parent.height;
                clicked => { root.preset-pressed(i); }
            }
        }
    }

    // ================================================================== EDIT
    if (root.screen == "edit"): Rectangle {
        x: 0; y: root.body-y; width: parent.width; height: root.body-h;

        HorizontalLayout {
            x: 0; y: 6px; width: parent.width; height: 40px;
            padding-left: 18px; padding-right: 10px; spacing: 4px;

            Text {
                horizontal-stretch: 1;
                text: root.edit-title != "" ? "Изменить пару" : "Новая пара";
                font-family: "Base 02"; font-size: 20px; color: Tokens.text;
                vertical-alignment: center;
                overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
            }
            IconButton {
                horizontal-stretch: 0;
                glyph: "\u{e5cd}"; size: 24px;
                pressed => { root.edit-close(); }
            }
        }

        FormField {
            x: 18px; y: 68px; width: parent.width - 36px; height: 44px;
            label: "Предмет";
            text <=> root.form-title;
        }
        FormField {
            x: 18px; y: 124px; width: parent.width - 36px; height: 44px;
            label: "Аудитория";
            text <=> root.form-room;
        }
        FormField {
            x: 18px; y: 180px; width: parent.width - 36px; height: 44px;
            label: "Преподаватель";
            text <=> root.form-teacher;
        }
        FormField {
            x: 18px; y: 236px; width: 190px; height: 44px;
            label: "Начало";
            text <=> root.form-start;
        }
        FormField {
            x: 222px; y: 236px; width: 190px; height: 44px;
            label: "Конец";
            text <=> root.form-end;
        }
        Text {
            x: 20px; y: 294px; width: parent.width - 40px; height: 18px;
            text: "Формат HH:MM";
            font-size: 11px; color: Tokens.accent;
        }
        Text {
            x: 20px; y: 326px; width: parent.width - 40px; height: 18px;
            text: "Тип занятия";
            font-size: 11.5px; color: Tokens.text;
        }

        PillButton { x: 18px; y: 352px; width: 76px; height: 38px; label: "Лекция"; active: root.form-kind == 0; pressed => { root.form-kind = 0; } }
        PillButton { x: 100px; y: 352px; width: 76px; height: 38px; label: "Практика"; active: root.form-kind == 1; pressed => { root.form-kind = 1; } }
        PillButton { x: 182px; y: 352px; width: 76px; height: 38px; label: "Лаба"; active: root.form-kind == 2; pressed => { root.form-kind = 2; } }
        PillButton { x: 264px; y: 352px; width: 60px; height: 38px; label: "Тест"; active: root.form-kind == 3; pressed => { root.form-kind = 3; } }
        PillButton { x: 330px; y: 352px; width: 82px; height: 38px; label: "Другое"; active: root.form-kind == 4; pressed => { root.form-kind = 4; } }

        PillButton {
            x: 18px; y: 436px; width: parent.width - 36px; height: 48px;
            label: "Сохранить";
            filled: true; radius: 14px;
            pressed => {
                root.edit-save(root.form-title, root.form-room, root.form-teacher, root.form-start, root.form-end, root.form-kind);
            }
        }
        PillButton {
            x: 18px; y: 494px; width: parent.width - 36px; height: 44px;
            label: "Отмена";
            pressed => { root.edit-close(); }
        }
    }

    // ============================================================== BOTTOM NAV
    Rectangle {
        x: 0; y: 792px; width: parent.width; height: 68px;
        background: Tokens.bg;
        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Tokens.border; }

        HorizontalLayout {
            x: 0; y: 1px; width: parent.width; height: 67px;

            // Schedule
            TouchArea {
                horizontal-stretch: 1;
                clicked => { root.nav-pressed("schedule"); }
                if (root.sched-active): Rectangle {
                    x: parent.width / 2 - 40px; y: 5px; width: 80px; height: 50px;
                    border-radius: 14px;
                    background: rgba(226, 162, 59, 0.18);
                }
                Icon {
                    x: 0; y: 11px; width: parent.width; height: 26px;
                    glyph: "\u{ebcc}"; icon-size: 24px;
                    tint: root.sched-active ? Tokens.accent : Tokens.muted;
                }
                Text {
                    x: 0; y: 39px; width: parent.width; height: 18px;
                    text: "Расписание"; font-size: 11.5px; font-weight: 700;
                    color: root.sched-active ? Tokens.accent : Tokens.muted;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }

            // Weather
            TouchArea {
                horizontal-stretch: 1;
                clicked => { root.nav-pressed("weather"); }
                if (root.screen == "weather"): Rectangle {
                    x: parent.width / 2 - 40px; y: 5px; width: 80px; height: 50px;
                    border-radius: 14px;
                    background: rgba(226, 162, 59, 0.18);
                }
                Icon {
                    x: 0; y: 11px; width: parent.width; height: 26px;
                    glyph: "\u{e1ff}"; icon-size: 24px;
                    tint: root.screen == "weather" ? Tokens.accent : Tokens.muted;
                }
                Text {
                    x: 0; y: 39px; width: parent.width; height: 18px;
                    text: "Погода"; font-size: 11.5px; font-weight: 700;
                    color: root.screen == "weather" ? Tokens.accent : Tokens.muted;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }

            // Transport
            TouchArea {
                horizontal-stretch: 1;
                clicked => { root.nav-pressed("transport"); }
                if (root.screen == "transport"): Rectangle {
                    x: parent.width / 2 - 40px; y: 5px; width: 80px; height: 50px;
                    border-radius: 14px;
                    background: rgba(226, 162, 59, 0.18);
                }
                Icon {
                    x: 0; y: 11px; width: parent.width; height: 26px;
                    glyph: "\u{e530}"; icon-size: 22px;
                    tint: root.screen == "transport" ? Tokens.accent : Tokens.muted;
                }
                Text {
                    x: 0; y: 39px; width: parent.width; height: 18px;
                    text: "Транспорт"; font-size: 11.5px; font-weight: 700;
                    color: root.screen == "transport" ? Tokens.accent : Tokens.muted;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // ================================================================== TOAST
    if (root.toast != ""): Rectangle {
        x: 18px; y: 730px; width: parent.width - 36px; height: 48px;
        border-radius: 14px;
        background: Tokens.card-raised;
        border-width: 1px; border-color: Tokens.border;

        Text {
            x: 14px; y: 0; width: parent.width - 28px; height: parent.height;
            text: root.toast;
            font-size: 14px; color: Tokens.text;
            horizontal-alignment: center; vertical-alignment: center;
            overflow: TextOverflow.elide; wrap: TextWrap.no-wrap;
        }
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.toast-dismissed(); }
        }
    }
}
