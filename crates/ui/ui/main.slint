        }

        // floating callouts
        Rectangle {
            x: 20px;
            y: 598px;
            width: 212px;
            height: 70px;
            border-radius: 14px;
            background: Tokens.elevated;
            border-width: 1px;
            border-color: Tokens.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);
            drop-shadow-offset-y: 6px;

