                }

                Text {
                    x: 106px;
                    y: 15px;
                    width: 286px;
                    text: block.title;
                    font-size: 15px;
                    font-weight: 700;
                    color: Tokens.text;
                    font-family: "Base 02"; // ponytail: Slint 1.19 takes one family; Latn/Cyrl fallbacks registered in lib.rs
                    overflow: TextOverflow.elide;
                    wrap: TextWrap.no-wrap;
                }

                Text {
                    x: 106px;
                    y: 38px;
                    width: 286px;
                    text: block.subtitle;
                    font-size: 12px;
                    color: Tokens.secondary;
                    overflow: TextOverflow.elide;
                    wrap: TextWrap.no-wrap;
