            }

            PillButton {
                x: 156px;
                y: 322px;
                width: 118px;
                height: 42px;
                label: "Preset 2";
                pressed => { root.preset-pressed(1); }
            }

            PillButton {
                x: 292px;
                y: 322px;
                width: 118px;
                height: 42px;
                label: "Preset 3";
                pressed => { root.preset-pressed(2); }
            }

            PillButton {
                x: 20px;
                y: 386px;
                width: 390px;
                height: 44px;
                label: "Check for updates";
                enabled: !root.busy;
                pressed => { root.update-pressed(); }
