            PillButton {
                x: 156px;
                y: 236px;
                width: 118px;
                height: 40px;
                label: "Cancel day";
                pressed => { root.cancel-day-pressed(); }
            }

            PillButton {
                x: 292px;
                y: 236px;
                width: 118px;
                height: 40px;
                label: "Check now";
                enabled: !root.busy;
                pressed => { root.update-pressed(); }
